            },
            {
                "id": "pp_organization",
                "pluralLabel": "Organizations",
                "singularLabel": "Organization",
                "tag": "dc:subject",
                "parseTagValue": true,
                "names": [
                    "organization"
                ]
            },
            {
                "id": "pp_gender",
                "pluralLabel": "Genders",
                "singularLabel": "Gender",
                "tag": "dc:subject",
                "parseTagValue": true,
                "names": [
                    "gender"
                ]
            },
            {
                "id": "pp_copyright_notice",
                "pluralLabel": "Copyright notices",
                "singularLabel": "Copyright notice",
                "tag": "dc:rights",
                "parseTagValue": false
            }
        ],
        "custom_taxonomies_tag_delimiter": ":",
        "alt_text_enable": true,
        "alt_text_from_file": true,
        "alt_text_template": "[photoshop:Headline]. [photopress:stringOfKeywords].",
        "description_enable": true,
        "description_template": "",
        "alt_text_tag": "photoshop:Headline",
        "strip_metadata_from_resized_image": false
