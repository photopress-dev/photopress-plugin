    "photopress_core_gallery": {
        "layout_masonry": true,
        "layout_rows": true,
        "layout_mosaic": true,
        "remove_deleted_images": true
    },
    "photopress_core_slideshow": {
        "enable": false,
        "showThumbnails": true,
        "showCaptions": true,
        "detail_position": "bottom",
        "thumbnailHeight": 120,
        "captionPadding": 0,
        "showTitleInCaption": false,
        "showDescriptionInCaption": false,
        "showAttachmentLink": false,
        "attachmentLinkText": "Read More..."
    },
    "photopress_core_search": {
        "attachment_pages": true,
        "images_in_search": true,
        "posts_in_search": true,
        "taxonomy_pages": true
    }
