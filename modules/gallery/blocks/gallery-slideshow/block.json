{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "photopress/gallery-slideshow",
	"title": "Gallery Slideshow",
	"category": "media",
	"description": "A slideshow of the images in a gallery on the same page. Clicking an image in the gallery shows it in the slideshow.",
	"keywords": [ "photopress", "slideshow", "carousel", "slider", "gallery" ],
	"textdomain": "photopress",
	"attributes": {
		"galleryAnchor": { "type": "string", "default": "" },
		"hideGallery": { "type": "boolean", "default": false },
		"sizeSlug": { "type": "string", "default": "large" },
		"autoplay": { "type": "boolean", "default": false },
		"delay": { "type": "number", "default": 3 },
		"effect": { "type": "string", "enum": [ "slide", "fade" ], "default": "slide" },
		"maxHeightOffset": { "type": "number", "default": 0 },
		"showCaptions": { "type": "boolean", "default": true },
		"captionPosition": { "type": "string", "enum": [ "below", "left", "right" ], "default": "below" },
		"captionPadding": { "type": "number", "default": 0 },
		"galleryNavigation": { "type": "boolean", "default": true },
		"scrollBehavior": { "type": "string", "enum": [ "instant", "smooth" ], "default": "instant" }
	},
	"usesContext": [ "postId" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"anchor": true,
		"spacing": { "margin": true }
	},
	"editorScript": "photopress-editor",
	"style": "photopress-frontend",
	"viewScript": "photopress-gallery-slideshow"
}
