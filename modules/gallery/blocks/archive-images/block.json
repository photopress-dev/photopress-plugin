{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "photopress/archive-images",
	"title": "Archive Images",
	"category": "media",
	"description": "The images of the archive page being viewed, such as a keyword's or a camera's, in a gallery layout, with links to more pages of them.",
	"keywords": [ "photopress", "archive", "taxonomy", "gallery", "masonry", "mosaic" ],
	"textdomain": "photopress",
	"attributes": {
		"layout": { "type": "string", "enum": [ "", "masonry", "rows", "mosaic" ], "default": "masonry" },
		"columnWidth": { "type": "number", "default": 300 },
		"rowHeight": { "type": "number", "default": 300 },
		"sizeSlug": { "type": "string", "default": "large" },
		"linkTo": { "type": "string", "enum": [ "attachment", "media", "none" ], "default": "attachment" },
		"slideshow": { "type": "boolean", "default": false },
		"showCaptions": { "type": "boolean", "default": false }
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"editorScript": "photopress-editor",
	"style": "photopress-frontend"
}
