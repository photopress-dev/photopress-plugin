{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "photopress/image-taxonomies",
	"title": "Image Metadata",
	"category": "media",
	"description": "The metadata of the current image: its taxonomy terms, such as keywords, people and places, and the exposure details from its file.",
	"keywords": [ "photopress", "taxonomy", "terms", "metadata", "keywords", "exif", "exposure", "camera" ],
	"textdomain": "photopress",
	"attributes": {
		"taxonomies": {
			"type": "array",
			"items": { "type": "string" },
			"default": []
		},
		"linkTerms": {
			"type": "boolean",
			"default": true
		},
		"showLabels": {
			"type": "boolean",
			"default": true
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true },
		"typography": { "fontSize": true, "lineHeight": true },
		"color": { "text": true, "background": true, "link": true }
	},
	"editorScript": "photopress-editor",
	"style": "photopress-frontend"
}
