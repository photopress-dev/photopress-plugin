{
    "name": "photopress/core",
    "description": "WordPress for Photographers",
    "keywords": [
        "WordPress",
        "photpress",
        "photo",
        "photography"
    ],
    "homepage": "https://www.photopressdev.com",
    "license": "GPL-3.0",
    "authors": [
        {
            "name": "The PhotoPress Team",
            "email": "hello@photopressdev.com"
        }
    ],
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "PhotoPress\\": [
                "./"
            ]
        },
        "classmap": [
            "framework/"
        ]
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "johnpbloch/wordpress-core": "^7.0",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit"
    },
    "require": {
        "woocommerce/action-scheduler": "^3.9"
    }
}
